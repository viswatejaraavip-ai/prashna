deploy/terraform/.terraform.lock.hcl

# Env files with secrets (keep .env.example)
.env
.env.local

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.kotlin/

# OS
.DS_Store

# App binary served from the site but not committed
backend/static/udhyath.apk
