# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Local data / logs
*.db
*.log
backend/local.db

# Terraform (state + secrets; deploy/terraform/.gitignore also covers these)
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.backup
deploy/terraform/terraform.tfvars
deploy/terraform/.terraform.lock.hcl

# Env files with secrets (keep .env.example)
.env
.env.local

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.kotlin/

# OS
.DS_Store

# App binary served from the site but not committed
backend/static/udhyath.apk
backend/.env.dev

# Evaluation: real people's charts and the readings about their lives.
# The public golden set holds only public figures; supply your own here.
backend/evals/golden_set.local.json
backend/evals/out/
backend/evals/out-dry/
backend/evals/RESULTS.local.md
backend/static/*.apk
