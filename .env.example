# Udhyath API on Google Cloud — local development settings.
# Copy to backend/.env.dev (or export in your shell). On Cloud Run these are
# set by terraform (deploy/gcp/terraform/run.tf) and secrets come from Secret
# Manager. Money is always integer paise (*_UNITS).

# --- Project / credentials ---
GOOGLE_CLOUD_PROJECT=udhyath-dev
FIREBASE_PROJECT_ID=udhyath-dev
# Local: `gcloud auth application-default login` supplies ADC.
# Firestore emulator (gcloud emulators firestore start --host-port=localhost:8081):
FIRESTORE_EMULATOR_HOST=localhost:8081
# Firebase Auth emulator (optional; `firebase emulators:start --only auth`):
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- Required secret ---
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRY_HOURS=720

# --- Operators (Google accounts allowed into /admin) ---
ADMIN_EMAILS=you@example.com
# Firebase web config for the dashboard's Google sign-in (public values)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
# FIREBASE_AUTH_DOMAIN=udhyath-dev.firebaseapp.com

# --- Languages ---
DEFAULT_LANG=te

# --- AI (no Vertex: Claude via the Anthropic API, Gemini via the Gemini API) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CLAUDE_MODEL=claude-opus-4-5
USD_TO_INR=90

# --- Pricing (paise) ---
QUERY_PRICE_UNITS=1000
QUERY_COST_CEILING_UNITS=500
TRIAL_CREDIT_UNITS=1000
PRO_PLAN_UNITS=49900
PRO_PLAN_DAYS=30
REPORT_FEE_UNITS=105000

# --- Payments ---
# Google Play Billing (primary). The runtime service account must be invited
# in Play Console; locally your ADC user needs the same access.
PLAY_PACKAGE_NAME=com.udhyath.app
# Razorpay (web top-ups / user-choice billing); empty disables it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Storage (PDFs, share cards) ---
GCS_BUCKET=udhyath-dev-udhyath-files
# Local signing of GCS URLs with user ADC: impersonate the runtime SA
# (you need roles/iam.serviceAccountTokenCreator on it).
# SIGNING_SERVICE_ACCOUNT=udhyath-run@udhyath-dev.iam.gserviceaccount.com

# --- Cron (Cloud Scheduler OIDC) ---
# On Cloud Run: service URL(s) and the scheduler service account.
CRON_AUDIENCES=
CRON_SA_EMAIL=
# Local only: skip OIDC checks for /internal/cron/* (ignored on Cloud Run).
CRON_INSECURE_DEV=1

# --- Legal pages (/api/legal/{doc}) ---
LEGAL_ENTITY_NAME=Your Company
SUPPORT_EMAIL=support@example.com
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_EMAIL=
LEGAL_ADDRESS=Hyderabad, Telangana, India
LEGAL_CITY=Hyderabad
LEGAL_EFFECTIVE_DATE=2026-10-01

PUBLIC_BASE_URL=http://localhost:8080

# --- Legacy AWS web app + /v1 (not used by the GCP path) ---
# DYNAMODB_TABLE=udhyath
# DYNAMODB_ENDPOINT_URL=http://localhost:8001
# INFERENCE_PROVIDER=bedrock
