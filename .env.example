# --- Required ---
JWT_SECRET=generate-a-long-random-string

# --- Inference (Claude in Amazon Bedrock by default) ---
INFERENCE_PROVIDER=bedrock
AWS_REGION=us-east-1
# Local dev only — on AWS use the task/instance IAM role instead:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Bedrock model IDs carry the anthropic. prefix:
# AGENT_MODEL=anthropic.claude-opus-4-8
# To use the first-party Anthropic API instead:
# INFERENCE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# --- Database: DynamoDB (on-demand) ---
DYNAMODB_TABLE=udhyath
# Local dev: point at DynamoDB Local / moto (docker compose sets this up)
# DYNAMODB_ENDPOINT_URL=http://localhost:8001

# --- Billing (INR wallet) ---
# Margin multiplier over raw Anthropic token cost (1.25 = 25% markup)
BILLING_MARGIN=1.25
# Flat per-session fee in paise = guaranteed minimum profit per session (5000 = Rs 50)
SESSION_FEE_UNITS=5000
# Conversion applied to Anthropic's USD prices (INR per USD)
USD_TO_WALLET_RATE=90
CURRENCY=INR

# --- Razorpay (leave empty to enable the dev top-up endpoint instead) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:8000

# --- Metered API & MCP ---
# Price per /v1 API call or MCP tool call, in paise (100 = Rs 1)
API_CALL_FEE_UNITS=100
# Public URLs shown in developer docs (API Gateway domains in production)
# PUBLIC_API_BASE_URL=https://api.astrology.example.com
# PUBLIC_MCP_URL=https://mcp.astrology.example.com/mcp

# --- Agent (experimental, prepay sessions) ---
AGENT_MAX_TOKENS=8192

# --- Optional: Swiss Ephemeris data files for maximum precision ---
# SE_EPHE_PATH=/app/ephe
